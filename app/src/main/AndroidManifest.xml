<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      INTERNET is required by Android for ANY socket, including the local HUD server that the laptop's
      glasses simulator (/sim) connects to over `adb forward`. The server binds to 127.0.0.1 unless the
      bench's "LAN HUD" toggle is on. There is no other network code in the app; the demo runs in
      airplane mode.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:name=".DejaLangoApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.DejaLango">

        <!-- LiteRT-LM's GPU backend (OpenCL) needs these declared; harmless when absent. -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Owns the microphone, the models and the pipeline. Survives the activity. -->
        <service
            android:name=".service.ListenService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
