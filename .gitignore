# Gradle / build
.gradle/
build/
**/build/
local.properties
.kotlin/

# IDE
.idea/
*.iml
.DS_Store
captures/
.externalNativeBuild
.cxx

# Models — never commit weights. scripts/fetch_models.sh populates ./models; scripts/push_models.sh pushes them.
models/
*.litertlm
*.onnx
!app/src/main/assets/silero_vad.onnx

# Traces and recordings exported from devices
traces/
*.wav
!app/src/debug/assets/fixtures/*.wav

# Language-server and editor output (copies of the sources)
**/bin/

# Internal docs live in internal/, a separate private repo (Wenjix/DejaLango-internal).
# docs/superpowers, docs/design and .impeccable are where tools write them by default;
# they become symlinks into internal/, so these patterns match a symlink or a directory.
/internal/
/docs/superpowers
/docs/design
/.impeccable

# macOS text-to-speech fixture: Apple's licence limits system-voice output to personal,
# non-commercial use, so it stays local. ElevenLabs fixtures can be committed here.
app/src/debug/assets/fixtures/demo_zh.wav
